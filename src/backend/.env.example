# Toda la configuración va por variables de entorno (ver las reglas del proyecto, reglas de portabilidad).
NODE_ENV=development
PORT=3000

# PostgreSQL 16 + PostGIS (docker compose up -d db)
DATABASE_URL=postgresql://fieldshift:fieldshift@localhost:5432/fieldshift?schema=public
POSTGRES_USER=fieldshift
POSTGRES_PASSWORD=fieldshift
POSTGRES_DB=fieldshift

# Orígenes permitidos para CORS, separados por comas (el frontend React)
CORS_ORIGIN=http://localhost:5173

# true = usa fixtures en vez de APIs externas
DEMO_OFFLINE=true

# Proxies delante del servidor (Caddy = 1). Necesario para que el límite de consultas use la IP real
TRUST_PROXY=0

# Datos descargados (solo lectura); el código nunca asume una ruta
RESOURCES_DIR=

# Protección de la API
GRAPHQL_MAX_DEPTH=6
GRAPHQL_MAX_COMPLEXITY=400
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_LIMIT_COSTOSO=20

# Esquema JSON del export de ml/ (por defecto ../../ml/deploy/export.schema.json)
EXPORT_SCHEMA_PATH=
