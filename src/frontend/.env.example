# Satellite basemap tiles ({z}/{y}/{x} or {z}/{x}/{y} template). License of the provider: [POR VERIFICAR].
VITE_BASEMAP_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_BASEMAP_ATTRIBUTION=Imagery © Esri, Maxar, Earthstar Geographics

# Backend GraphQL endpoint (Field Shift API). Must be allowed by the backend CORS_ORIGIN.
VITE_API_URL=http://localhost:3000/graphql

# En producción (Cloudflare Pages) definir VITE_API_URL con la URL pública de la API, p. ej. https://fieldshift-api.onrender.com/graphql
# y también VITE_BASEMAP_TILES_URL / VITE_BASEMAP_ATTRIBUTION (el build solo lee las variables del panel, no este archivo).
