{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Field Shift export",
  "schema_version": 1,
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "layer",
            "points",
            "series",
            "summaries",
            "tables"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "modelo",
            "regla-base",
            "indice"
          ],
          "title": "Role",
          "type": "string"
        },
        "algorithm": {
          "title": "Algorithm",
          "type": "string"
        },
        "trained_rows": {
          "title": "Trained Rows",
          "type": "integer"
        },
        "trained_through": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trained Through"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "ci_lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Lo"
        },
        "ci_hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Hi"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Value"
        },
        "skill": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "concept",
        "name",
        "role",
        "algorithm",
        "trained_rows",
        "metric"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "fips": {
          "title": "Fips",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "name",
        "fips",
        "bbox"
      ],
      "title": "Zone",
      "type": "object"
    },
    "file_manifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "zone": {
          "$ref": "#/$defs/Zone"
        },
        "data_as_of": {
          "format": "date",
          "title": "Data As Of",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelInfo"
          },
          "title": "Models",
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "title": "Files",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "version",
        "generated_at",
        "zone",
        "data_as_of",
        "models",
        "files",
        "limitations"
      ],
      "title": "ExportManifest",
      "type": "object"
    },
    "ColorStop": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "maximum": 1,
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "color": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "at",
        "color"
      ],
      "title": "ColorStop",
      "type": "object"
    },
    "ScenarioGrid": {
      "additionalProperties": false,
      "description": "One grid of the layer for one what-if scenario. `values` is row-major from the NORTH edge; null = no data.",
      "properties": {
        "rain_pct": {
          "maximum": 100,
          "minimum": -100,
          "title": "Rain Pct",
          "type": "integer"
        },
        "temp_delta": {
          "maximum": 10,
          "minimum": -10,
          "title": "Temp Delta",
          "type": "number"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "rain_pct",
        "temp_delta",
        "values"
      ],
      "title": "ScenarioGrid",
      "type": "object"
    },
    "file_layer": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "temperature",
            "humidity",
            "rain",
            "drought",
            "vulnerability",
            "elevation",
            "slope",
            "erosion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "ramp": {
          "items": {
            "$ref": "#/$defs/ColorStop"
          },
          "title": "Ramp",
          "type": "array"
        },
        "legend": {
          "items": {
            "type": "string"
          },
          "title": "Legend",
          "type": "array"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "cols": {
          "exclusiveMinimum": 0,
          "title": "Cols",
          "type": "integer"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ScenarioGrid"
          },
          "minItems": 1,
          "title": "Scenarios",
          "type": "array"
        },
        "scenario_applies": {
          "title": "Scenario Applies",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "resolution_m": {
          "title": "Resolution M",
          "type": "integer"
        },
        "interpolated": {
          "title": "Interpolated",
          "type": "boolean"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "concept",
        "title",
        "variable",
        "unit",
        "min",
        "max",
        "ramp",
        "legend",
        "bbox",
        "cols",
        "rows",
        "scenarios",
        "scenario_applies",
        "source",
        "resolution_m",
        "interpolated",
        "as_of"
      ],
      "title": "Layer",
      "type": "object"
    },
    "MapPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "kind": {
          "enum": [
            "stress",
            "erosion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "lat",
        "lon",
        "kind"
      ],
      "title": "MapPoint",
      "type": "object"
    },
    "file_points": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "stress",
            "erosion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/MapPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "concept",
        "source",
        "as_of",
        "points"
      ],
      "title": "PointsFile",
      "type": "object"
    },
    "Series": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "concept": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept"
        },
        "a_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "A Label"
        },
        "b_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "B Label"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/SeriesPoint"
          },
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "unit",
        "source",
        "points"
      ],
      "title": "Series",
      "type": "object"
    },
    "SeriesPoint": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "a": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "A"
        },
        "b": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "B"
        },
        "forecast": {
          "default": false,
          "title": "Forecast",
          "type": "boolean"
        }
      },
      "required": [
        "label"
      ],
      "title": "SeriesPoint",
      "type": "object"
    },
    "file_series": {
      "additionalProperties": false,
      "properties": {
        "series": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "title": "Series",
          "type": "array"
        }
      },
      "required": [
        "series"
      ],
      "title": "SeriesFile",
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "drought",
            "stress",
            "erosion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "value",
        "unit",
        "detail",
        "definition",
        "concept",
        "as_of"
      ],
      "title": "Alert",
      "type": "object"
    },
    "ClimateSummary": {
      "additionalProperties": false,
      "properties": {
        "rain_next_day_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rain Next Day Pct"
        },
        "rain_next_months_mm": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Rain Next Months Mm",
          "type": "array"
        },
        "heatwave_next7_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heatwave Next7 Pct"
        },
        "temperature_max_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Max C"
        },
        "temperature_min_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Min C"
        },
        "temperature_mean_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Mean C"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "as_of"
      ],
      "title": "ClimateSummary",
      "type": "object"
    },
    "HumiditySummary": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "title": "Root",
          "type": "number"
        },
        "surface": {
          "title": "Surface",
          "type": "number"
        },
        "evaporation": {
          "title": "Evaporation",
          "type": "number"
        },
        "percentile": {
          "title": "Percentile",
          "type": "number"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "root",
        "surface",
        "evaporation",
        "percentile",
        "as_of",
        "source"
      ],
      "title": "HumiditySummary",
      "type": "object"
    },
    "file_summaries": {
      "additionalProperties": false,
      "properties": {
        "alerts": {
          "items": {
            "$ref": "#/$defs/Alert"
          },
          "title": "Alerts",
          "type": "array"
        },
        "humidity": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumiditySummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "climate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClimateSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unavailable": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unavailable",
          "type": "array"
        }
      },
      "required": [
        "alerts"
      ],
      "title": "Summaries",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "description": "Small generic table for the model outputs that have no map layer (yield, rotation, cycle length).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "id",
        "concept",
        "title",
        "rows"
      ],
      "title": "Table",
      "type": "object"
    },
    "file_tables": {
      "additionalProperties": false,
      "properties": {
        "tables": {
          "items": {
            "$ref": "#/$defs/Table"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "tables"
      ],
      "title": "TablesFile",
      "type": "object"
    }
  }
}
